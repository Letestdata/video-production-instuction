## 5. Reusable Remotion / React Component Recipes

### Component 1: The "Red Pill" Stat Card (`RedPillCard.tsx`)
```tsx
import React from 'react';
import { interpolate, spring, useCurrentFrame, useVideoConfig } from 'remotion';

interface RedPillCardProps {
  label: string;
  value: string;
  subtext?: string;
  enterFrame?: number;
}

export const RedPillCard: React.FC<RedPillCardProps> = ({
  label,
  value,
  subtext,
  enterFrame = 0,
}) => {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();

  const relFrame = Math.max(0, frame - enterFrame);
  const scale = spring({
    frame: relFrame,
    fps,
    config: { damping: 12, stiffness: 220, mass: 0.8 },
  });

  const opacity = interpolate(relFrame, [0, 6], [0, 1], { extrapolateRight: 'clamp' });
  const idleGlow = Math.sin((frame / fps) * 3) * 8 + 16;

  return (
    <div
      style={{
        transform: `scale(${scale})`,
        opacity,
        backgroundColor: '#E50914',
        borderRadius: 24,
        padding: '24px 36px',
        boxShadow: `0 14px 40px rgba(229, 9, 20, 0.45), 0 0 ${idleGlow}px rgba(229, 9, 20, 0.6)`,
        display: 'flex',
        flexDirection: 'column',
        alignItems: 'center',
        justifyContent: 'center',
        maxWidth: 780,
        margin: '16px auto',
        border: '2px solid rgba(255, 255, 255, 0.35)',
      }}
    >
      <span
        style={{
          color: '#FFFFFF',
          fontSize: 26,
          fontWeight: 700,
          letterSpacing: 2,
          textTransform: 'uppercase',
          fontFamily: 'Montserrat, sans-serif',
          opacity: 0.9,
        }}
      >
        {label}
      </span>
      <span
        style={{
          color: '#FFFFFF',
          fontSize: 58,
          fontWeight: 900,
          fontFamily: 'Montserrat, sans-serif',
          marginTop: 6,
          lineHeight: 1.1,
          textAlign: 'center',
        }}
      >
        {value}
      </span>
      {subtext && (
        <span
          style={{
            color: 'rgba(255, 255, 255, 0.85)',
            fontSize: 22,
            fontWeight: 500,
            marginTop: 8,
            textAlign: 'center',
          }}
        >
          {subtext}
        </span>
      )}
    </div>
  );
};
```

